{
  "name": "peep-note",
  "version": "1.1.1",
  "description": "Desktop capture and activity log for notes, screenshots, and recordings",
  "author": {
    "name": "PeepNote contributors"
  },
  "homepage": "https://github.com/OddlyGoods/peep-note",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "vite build && node scripts/patch-html.js && electron-builder",
    "build:linux": "vite build && node scripts/patch-html.js && electron-builder --linux deb --publish never",
    "build:linux:dir": "vite build && node scripts/patch-html.js && electron-builder --linux dir",
    "build:win": "vite build && node scripts/patch-html.js && electron-builder --win nsis --x64 --publish never",
    "release": "vite build && node scripts/patch-html.js && electron-builder --publish always",
    "preview": "vite preview",
    "test:features": "node scripts/test-features.cjs",
    "test:updates": "node scripts/test-updates.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "test:local": "node scripts/test-local.cjs",
    "typecheck": "tsc --noEmit",
    "test:privacy": "node scripts/audit-source.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "date-fns": "^3.6.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.4.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.24.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.10",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.openpeepnote.app",
    "productName": "PeepNote",
    "publish": {
      "provider": "github",
      "owner": "OddlyGoods",
      "repo": "peep-note",
      "private": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/{tesseract.js,tesseract.js-core,regenerator-runtime,wasm-feature-detect,is-url,node-fetch,whatwg-url,tr46,webidl-conversions,bmp-js,zlibjs,idb-keyval}/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "artifactName": "PeepNote-${version}-win-${arch}-Setup.${ext}"
    },
    "deb": {
      "recommends": [
        "pkexec"
      ],
      "fpm": [
        "--replaces=open-peep-note",
        "--conflicts=open-peep-note"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "extraFiles": [
        {
          "from": "resources/linux/open-peep-note",
          "to": "open-peep-note"
        }
      ],
      "maintainer": "chYoo01 <chYoo01@users.noreply.github.com>",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons",
      "category": "Utility",
      "executableName": "peep-note",
      "artifactName": "PeepNote-${version}-linux-${arch}.${ext}",
      "desktop": {
        "Name": "PeepNote",
        "Comment": "Capture and organize screenshots, recordings, and notes",
        "Categories": "Utility;Office;",
        "StartupWMClass": "PeepNote"
      }
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OddlyGoods/peep-note.git"
  }
}
